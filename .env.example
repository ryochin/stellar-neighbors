# Destination: the bucket root (served at the subdomain root) or a prefix.
# The sync uses --delete, so anything in this location that is not in dist/ is removed.
S3_BUCKET=s3://my-bucket
# Leave empty for AWS S3; set for R2 / RustFS / Wasabi etc.
S3_ENDPOINT_URL=
# Credentials are read by the AWS CLI (profile or env vars).
# Uncomment only when needed: an empty AWS_PROFILE makes the CLI look for a profile named "".
# AWS_PROFILE=my-profile
# "auto" for R2; a real region such as us-east-1 for AWS S3
# AWS_REGION=auto
# 1 = show what would be uploaded without uploading
DRY_RUN=
